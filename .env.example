# Copy to .env for running on your computer. On Cloud Run, set these as environment
# variables / secrets instead. Never paste these values into a chat or commit them.

# --- Tekmetric ---
TEKMETRIC_CLIENT_ID=
TEKMETRIC_CLIENT_SECRET=
# sandbox or production
TEKMETRIC_ENV=sandbox

# --- Google sign-in ---
# OAuth client ID (type: Web application) from Google Cloud console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=toydoctorinc.com
# Any long random string. Keeps sign-ins valid across restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Storage for assignments ---
# file (default, saves to data/store.json — fine on your computer) or firestore (use this on Cloud Run)
STORE=file

# --- Demo / development ---
# true = sample data instead of Tekmetric
TEKMETRIC_MOCK=false
# true = skip sign-in (only for running on your own computer)
AUTH_DISABLED=false
